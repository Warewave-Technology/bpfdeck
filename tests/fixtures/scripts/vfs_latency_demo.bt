#!/usr/bin/env bpftrace
// vfs_latency_demo.bt	vfs_read latency as a log2 histogram (usecs).
//			Fixture for histogram rendering.

BEGIN
{
  printf("Tracing vfs_read latency... Hit Ctrl-C to end.\n");
}

kprobe:vfs_read
{
  @start[tid] = nsecs;
}

kretprobe:vfs_read
/@start[tid]/
{
  @usecs = hist((nsecs - @start[tid]) / 1000);
  delete(@start, tid);
}

END
{
  clear(@start);
}
